# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Environment and secrets
.env
*.key
*.pem

# Data and model artifacts (too large for Git)
data/raw/*
data/processed/*
data/tokenized/*
checkpoints/*
logs/*
experiments/runs/*
experiments/plots/*
experiments/reports/*

# Keep directory structure via README files
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/tokenized/.gitkeep
!checkpoints/.gitkeep
!logs/.gitkeep
!experiments/.gitkeep
!experiments/README.md

# Jupyter
.ipynb_checkpoints/

# PyTorch
*.pt
*.pth
*.onnx

# TensorBoard
runs/

# Misc
*.log
*.tmp
*.bak
