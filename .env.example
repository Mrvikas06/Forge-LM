# ForgeLM Environment Configuration
# Copy this file to .env and fill in values as needed.

# Project paths (optional overrides)
# FORGELM_DATA_DIR=./data
# FORGELM_CHECKPOINT_DIR=./checkpoints
# FORGELM_LOG_DIR=./logs

# Device configuration
# CUDA_VISIBLE_DEVICES=0

# Experiment tracking
# FORGELM_EXPERIMENT_NAME=default
